# ─────────────────────────────────────────────────────────────────────────────
# Trailog — environment configuration template
# Copy to .env and fill in your values.
# Existing shell/process env vars always win over .env values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ───────────────────────────────────────────────────────

# Which database engine to use.  Choose one of: postgres | mysql | sqlserver
TRAILOG_DB_DRIVER=postgres

# Connection string for the chosen driver.
#
# Postgres:
#   TRAILOG_DB_DSN=postgres://user:password@localhost:5432/auditdb?sslmode=disable
#
# MySQL (parseTime=true is required so DATETIME columns scan into time.Time):
#   TRAILOG_DB_DSN=user:password@tcp(localhost:3306)/auditdb?parseTime=true&loc=UTC
#
# SQL Server:
#   TRAILOG_DB_DSN=sqlserver://user:password@localhost:1433?database=auditdb
TRAILOG_DB_DSN=postgres://user:password@localhost:5432/auditdb?sslmode=disable

# ── Migrations ────────────────────────────────────────────────────────────────

# Run pending migrations automatically on startup.  Default: true
# Set to false if you manage migrations separately (CI/CD pipeline, Flyway, etc.)
TRAILOG_RUN_MIGRATIONS=true

# ── HTTP API server ───────────────────────────────────────────────────────────

# TCP address the API server listens on.  Default: :8080
TRAILOG_HTTP_ADDR=:8080

# HTTP timeout settings (Go duration strings: 15s, 1m30s, …)
TRAILOG_HTTP_READ_TIMEOUT=15s
TRAILOG_HTTP_WRITE_TIMEOUT=30s
TRAILOG_HTTP_IDLE_TIMEOUT=60s

# ── Async dispatcher ──────────────────────────────────────────────────────────

# Enable async write path (non-blocking; audit writes happen in a background
# worker pool).  Default: false (synchronous — safer for low-volume deployments)
TRAILOG_ASYNC=false

# In-memory queue depth before falling back to synchronous writes.  Default: 512
TRAILOG_ASYNC_BUFFER=512

# Number of background worker goroutines draining the queue.  Default: 4
TRAILOG_ASYNC_WORKERS=4

# ── Observability ─────────────────────────────────────────────────────────────

# Log verbosity.  One of: debug | info | warn | error   Default: info
TRAILOG_LOG_LEVEL=info

# ── .env file location (meta-option) ─────────────────────────────────────────

# If this variable is set in the process environment before startup, trailog
# will load that file instead of the default ".env".
# Useful when running multiple services from the same directory.
# TRAILOG_ENV_FILE=configs/audit.env
